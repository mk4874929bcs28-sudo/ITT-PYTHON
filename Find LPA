salary=float(input("Enter annual salary(in LPA):"))
tax = 0.0
if salary <= 2.5:
    tax = 0.0
elif salary <= 5.0:
    tax = (salary - 2.5) * 0.05
elif salary <= 10.0:
    tax = (2.5 * 0.05) + (salary - 5.0) * 0.10
else:
    tax = (2.5 * 0.05) + (5.0 * 0.10) + (salary - 10.0) * 0.15

print("Total tax to be paid: %.2f LPA" % tax)
