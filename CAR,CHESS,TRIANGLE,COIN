T = int(input("Enter T Value:"))
T_count = 0
while T_count < T:
	N = int(input("Enter N:"))
	triangle = []
	i = 0
	while i < N:
		row = list(map(int, input().split()))
		triangle.append(row)
		i = i + 1
	row_idx = N - 2
	while row_idx >= 0:
		col_idx = 0
		while col_idx <= row_idx:
			left = triangle[row_idx + 1][col_idx]
			right = triangle[row_idx + 1][col_idx + 1]
			if left > right:
				triangle[row_idx][col_idx] = triangle[row_idx][col_idx] + left
			else:
				triangle[row_idx][col_idx] = triangle[row_idx][col_idx] + right
            
			col_idx = col_idx + 1
		row_idx = row_idx - 1
	if N > 0:
		print(triangle[0][0])
        
	T_count = T_count + 1

