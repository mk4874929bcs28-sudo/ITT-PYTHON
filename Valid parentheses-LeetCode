class Solution:
    def isValid(self, s: str) -> bool:
        stack = []
        lookup = {"(": ")", "{": "}", "[": "]"}
        
        for char in s:
            if char in lookup:
                stack.append(char)
            # If stack is empty or the top bracket doesn't match
            elif not stack or lookup[stack.pop()] != char:
                return False
                
        return len(stack) == 0
