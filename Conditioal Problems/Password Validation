T=int(input("Enter number of TestCases:"))
for i in range(T):
        password=input("Enter your Password:")
        length=space=digit=lower=upper=special=0
        special_characters="@#$%^&*()-_+={}<>!?|/[]"
        for x in password:
                length+=1
                if x==" ":
                        space+=1
                elif '0'<=x<='9':
                        digit+=1
                elif 'a'<=x<='z':
                        lower+=1
                elif 'A'<=x<='Z':
                        upper+=1
                elif x in special_characters:
                        special+=1
        if space>0:
                print("Invalid! Password should not contain any spaces.")
        elif length<8 or length>15:
                print("Invalid! Password should  contain 8 to 15 characters.")
        elif digit==0:
                print("Password should contain atleast one digit.")
        elif lower==0:
                print("Password should contain atleast one lowercase characters.")
        elif upper==0:
                print("Password should contain atleast one uppercase characters.")
        elif special==0:
                print("Password should contain atleast one special characters.")
        else:
                print("Your Password is Valid!")
