data = input().split()
day = int(data[0])
month = int(data[1])
year = int(data[2])
if month < 3:
    month += 12
    year -= 1
k = year % 100
j = year // 100
h = (day + ((13 * (month + 1)) // 5) + k + (k // 4) + (j // 4) - (2 * j)) % 7
days = ["SATURDAY", "SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]
print(days[h])
