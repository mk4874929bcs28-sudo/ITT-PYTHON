try:
    data = input().split()
    if len(data) != 2:
        raise ValueError
    a = float(data[0])
    b = float(data[1])
    result = a / b
    if result == int(result):
        print(int(result))
    else:
        print(result)
except ZeroDivisionError:
    print("Error: Division by zero")
except ValueError:
    print("Error: Invalid input")
